{
  "name": "@invertix/open-sb",
  "version": "0.1.0",
  "description": "One TypeScript interface for agent sandboxes across 17 providers, with capabilities checked at type-check time, at startup and in CI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertix-ai/open-sb.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./agent37": {
      "types": "./dist/providers/agent37.d.ts",
      "default": "./dist/providers/agent37.js"
    },
    "./beam": {
      "types": "./dist/providers/beam.d.ts",
      "default": "./dist/providers/beam.js"
    },
    "./blaxel": {
      "types": "./dist/providers/blaxel.d.ts",
      "default": "./dist/providers/blaxel.js"
    },
    "./boat": {
      "types": "./dist/providers/boat.d.ts",
      "default": "./dist/providers/boat.js"
    },
    "./codesandbox": {
      "types": "./dist/providers/codesandbox.d.ts",
      "default": "./dist/providers/codesandbox.js"
    },
    "./daytona": {
      "types": "./dist/providers/daytona.d.ts",
      "default": "./dist/providers/daytona.js"
    },
    "./docker": {
      "types": "./dist/providers/docker.d.ts",
      "default": "./dist/providers/docker.js"
    },
    "./e2b": {
      "types": "./dist/providers/e2b.d.ts",
      "default": "./dist/providers/e2b.js"
    },
    "./fly": {
      "types": "./dist/providers/fly.d.ts",
      "default": "./dist/providers/fly.js"
    },
    "./freestyle": {
      "types": "./dist/providers/freestyle.d.ts",
      "default": "./dist/providers/freestyle.js"
    },
    "./hopx": {
      "types": "./dist/providers/hopx.d.ts",
      "default": "./dist/providers/hopx.js"
    },
    "./modal": {
      "types": "./dist/providers/modal.d.ts",
      "default": "./dist/providers/modal.js"
    },
    "./morph": {
      "types": "./dist/providers/morph.d.ts",
      "default": "./dist/providers/morph.js"
    },
    "./runloop": {
      "types": "./dist/providers/runloop.d.ts",
      "default": "./dist/providers/runloop.js"
    },
    "./sprites": {
      "types": "./dist/providers/sprites.d.ts",
      "default": "./dist/providers/sprites.js"
    },
    "./upstash": {
      "types": "./dist/providers/upstash.d.ts",
      "default": "./dist/providers/upstash.js"
    },
    "./vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "default": "./dist/providers/vercel.js"
    }
  },
  "bin": {
    "open-sb": "./bin/open-sb.ts"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p playground/web",
    "test": "node --test test/*.test.ts",
    "graphic": "node scripts/graphic.ts",
    "playground": "node playground/build-web.ts && node playground/server.ts",
    "playground:build": "vite build --config playground/web/vite.config.ts",
    "playground:dev": "vite --config playground/web/vite.config.ts",
    "test:agent37": "node --test test/agent37.conformance.ts",
    "test:beam": "node --test test/beam.conformance.ts",
    "test:blaxel": "node --test test/blaxel.conformance.ts",
    "test:boat": "node --test test/boat.conformance.ts",
    "test:codesandbox": "node --test test/codesandbox.conformance.ts",
    "test:daytona": "node --test test/daytona.conformance.ts",
    "test:docker": "node --test test/docker.conformance.ts",
    "test:e2b": "node --test test/e2b.conformance.ts",
    "test:fly": "node --test test/fly.conformance.ts",
    "test:freestyle": "node --test test/freestyle.conformance.ts",
    "test:hopx": "node --test test/hopx.conformance.ts",
    "test:modal": "node --test test/modal.conformance.ts",
    "test:morph": "node --test test/morph.conformance.ts",
    "test:runloop": "node --test test/runloop.conformance.ts",
    "test:sprites": "node --test test/sprites.conformance.ts",
    "test:upstash": "node --test test/upstash.conformance.ts",
    "test:vercel": "node --test test/vercel.conformance.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "rm -rf dist && pnpm run build && pnpm pack"
  },
