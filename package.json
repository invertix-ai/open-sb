{
  "name": "@invertix/open-sb",
  "version": "0.1.0",
  "description": "One TypeScript interface for agent sandboxes: Boat, E2B, Daytona, Vercel Sandbox, Modal, Agent37 and Docker, with capabilities checked at type-check time, at startup and in CI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./conformance": "./src/conformance.ts",
    "./boat": "./src/providers/boat.ts",
    "./agent37": "./src/providers/agent37.ts",
    "./docker": "./src/providers/docker.ts",
    "./e2b": "./src/providers/e2b.ts",
    "./daytona": "./src/providers/daytona.ts",
    "./vercel": "./src/providers/vercel.ts",
    "./modal": "./src/providers/modal.ts"
  },
  "bin": {
    "open-sb": "./bin/open-sb.ts"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:docker": "node --test test/docker.conformance.ts",
    "test:boat": "node --test test/boat.conformance.ts",
    "test:agent37": "node --test test/agent37.conformance.ts",
    "test:e2b": "node --test test/e2b.conformance.ts",
    "test:daytona": "node --test test/daytona.conformance.ts",
    "test:vercel": "node --test test/vercel.conformance.ts",
    "test:modal": "node --test test/modal.conformance.ts"
  },
  "peerDependencies": {
    "@boatdev/sdk": ">=1.13.0",
    "e2b": ">=2.64.0",
    "@daytonaio/sdk": ">=0.232.0",
    "@vercel/sandbox": ">=4.1.0",
    "modal": ">=0.11.2"
  },
  "peerDependenciesMeta": {
    "@boatdev/sdk": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "@daytonaio/sdk": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "modal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@boatdev/sdk": "^1.13.0",
    "@daytonaio/sdk": "^0.232.0",
    "@types/node": "^26.6.6",
    "@vercel/sandbox": "^4.1.0",
    "e2b": "^2.64.0",
    "modal": "^0.11.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.5",
  "keywords": [
    "sandbox",
    "agents",
    "ai",
    "e2b",
    "daytona",
    "vercel-sandbox",
    "modal",
    "boat",
    "docker",
    "vm"
  ],
  "pnpm": {
    "ignoredBuiltDependencies": [
      "cbor-extract",
      "protobufjs"
    ]
  }
}
